server.port=8080
java.opts=-Xmx512m -Xms256m
spring.application.name=workflow-backend
app.security.allowed-origins=https://produsoft.onrender.com,http://localhost:3000
OLLAMA_API_KEY=replace-with-your-ollama-api-key
DB_HOST=replace-with-your-db-host
